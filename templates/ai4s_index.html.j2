<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AI4S Daily</title>
  <style>
    :root {
      --bg: #f3f6f4;
      --surface: #ffffff;
      --ink: #17211d;
      --muted: #647169;
      --line: #dbe3de;
      --accent: #176b50;
      --accent-soft: #e1f2eb;
      --blue: #315b7d;
      --high: #176b50;
      --mid: #9a6700;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
        "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      line-height: 1.65;
    }
    a { color: inherit; }
    .shell { width: min(1040px, calc(100% - 40px)); margin: 0 auto; }
    .site-header {
      background: rgba(255, 255, 255, .94);
      border-bottom: 1px solid var(--line);
      position: sticky;
      top: 0;
      z-index: 20;
      backdrop-filter: blur(12px);
    }
    .header-inner {
      min-height: 82px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }
    .brand h1 { margin: 0; font-size: 24px; letter-spacing: -.02em; }
    .brand p { margin: 2px 0 0; color: var(--muted); font-size: 12px; }
    .view-switch { display: flex; gap: 6px; padding: 4px; border-radius: 10px; background: #edf1ee; }
    .view-switch a {
      padding: 7px 16px;
      border-radius: 7px;
      color: var(--muted);
      font-size: 14px;
      font-weight: 650;
      text-decoration: none;
    }
    .view-switch a.active { background: var(--surface); color: var(--accent); box-shadow: 0 1px 4px #18271e18; }
    .category-nav {
      margin: 26px 0 22px;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .category-nav button {
      border: 1px solid var(--line);
      background: var(--surface);
      color: var(--muted);
      border-radius: 999px;
      padding: 7px 13px;
      cursor: pointer;
      font: inherit;
      font-size: 13px;
    }
    .category-nav button.active { background: var(--accent); border-color: var(--accent); color: white; }
    main { padding-bottom: 64px; }
    .view[hidden] { display: none; }
    .report-head { margin: 28px 0 20px; }
    .eyebrow { margin: 0 0 4px; color: var(--accent); font-size: 12px; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
    .report-head h2 { margin: 0; font-size: clamp(25px, 4vw, 38px); letter-spacing: -.035em; }
    .report-head .meta { margin: 8px 0 0; color: var(--muted); font-size: 14px; }
    .cards { display: grid; gap: 18px; }
    .card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 24px;
      box-shadow: 0 8px 30px rgba(32, 52, 42, .045);
    }
    .card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; }
    .card h3 { margin: 0; font-size: 20px; line-height: 1.35; }
    .card h3 a { text-decoration: none; }
    .card h3 a:hover { color: var(--accent); }
    .score {
      min-width: 42px;
      border-radius: 9px;
      padding: 5px 8px;
      color: white;
      text-align: center;
      font-weight: 750;
      font-size: 13px;
    }
    .score.high { background: var(--high); }
    .score.mid { background: var(--mid); }
    .badges, .tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 12px; }
    .badge, .tag { border-radius: 6px; padding: 3px 8px; font-size: 12px; }
    .badge { background: var(--accent-soft); color: var(--accent); font-weight: 650; }
    .badge.type { background: #e7eef5; color: var(--blue); }
    .tag { background: #f0f2f0; color: var(--muted); }
    .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px 22px; margin-top: 22px; }
    .field { min-width: 0; }
    .field h4 { margin: 0 0 4px; color: var(--muted); font-size: 12px; letter-spacing: .06em; }
    .field p { margin: 0; white-space: pre-line; overflow-wrap: anywhere; }
    .card-foot {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      border-top: 1px solid var(--line);
      margin-top: 22px;
      padding-top: 15px;
      color: var(--muted);
      font-size: 13px;
    }
    .read-link { margin-left: auto; color: var(--accent); font-weight: 700; text-decoration: none; }
    .weekly-layout { display: grid; gap: 18px; }
    .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 24px; }
    .panel h3 { margin: 0 0 12px; font-size: 18px; }
    .panel p { margin: 0; white-space: pre-line; }
    .trend-list { display: grid; gap: 12px; }
    .trend { padding: 16px; background: #f7faf8; border-left: 3px solid var(--accent); border-radius: 4px 9px 9px 4px; }
    .trend h4 { margin: 0 0 5px; color: var(--accent); }
    .trend p { margin: 0; }
    .watchlist { margin: 0; padding-left: 22px; }
    .watchlist li + li { margin-top: 7px; }
    .representative .summary-grid { grid-template-columns: 1fr; }
    .empty { padding: 42px 24px; border: 1px dashed #bfcac3; border-radius: 14px; text-align: center; color: var(--muted); background: #f8faf8; }
    .filter-empty { display: none; margin-top: 16px; }
    footer.site-footer { border-top: 1px solid var(--line); padding: 22px 0 36px; color: var(--muted); font-size: 12px; }
    @media (max-width: 700px) {
      .shell { width: min(100% - 24px, 1040px); }
      .header-inner { min-height: 70px; align-items: flex-start; flex-direction: column; gap: 10px; padding: 14px 0; }
      .view-switch { width: 100%; }
      .view-switch a { flex: 1; text-align: center; }
      .category-nav { margin-top: 18px; overflow: visible; }
      .category-nav button { flex: 0 0 auto; }
      .card, .panel { padding: 18px; }
      .card-head { flex-direction: column; }
      .summary-grid { grid-template-columns: 1fr; }
      .read-link { width: 100%; margin-left: 0; }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="shell header-inner">
      <div class="brand">
        <h1>AI4S Daily</h1>
        <p>AI for Science research brief · generated {{ generated_at }}</p>
      </div>
      <nav class="view-switch" aria-label="报告类型">
        <a href="#daily" data-view-button="daily">Daily</a>
        <a href="#weekly" data-view-button="weekly">Weekly</a>
      </nav>
    </div>
  </header>

  <main class="shell">
    <nav class="category-nav" aria-label="领域筛选">
      {% for category_id, label in categories %}
      <button type="button" data-category-button="{{ category_id }}">{{ label }}</button>
      {% endfor %}
    </nav>

    {% macro report_card(report_item, compact=false) -%}
      {% set analysis = report_item.analysis %}
      {% set summary = analysis.summary %}
      <article class="card{% if compact %} representative{% endif %}" data-report-card data-category="{{ report_item.category }}">
        <div class="card-head">
          <h3><a href="{{ analysis.item.url }}" target="_blank" rel="noopener noreferrer">{{ analysis.item.title }}</a></h3>
          <span class="score {{ 'high' if analysis.analyzer.score >= 8 else 'mid' }}">{{ analysis.analyzer.score }}/10</span>
        </div>
        <div class="badges">
          <span class="badge">{{ category_labels[report_item.category] }}</span>
          <span class="badge type">{{ content_type_labels[analysis.analyzer.content_type] }}</span>
        </div>
        {% if analysis.analyzer.tags %}
        <div class="tags">{% for tag in analysis.analyzer.tags %}<span class="tag">{{ tag }}</span>{% endfor %}</div>
        {% endif %}
        {% if compact %}
        <div class="summary-grid"><div class="field"><h4>主要结果</h4><p>{{ summary.main_result }}</p></div></div>
        {% else %}
        <div class="summary-grid">
          <div class="field"><h4>科学问题</h4><p>{{ summary.scientific_problem }}</p></div>
          <div class="field"><h4>AI 方法</h4><p>{{ summary.ai_method }}</p></div>
          <div class="field"><h4>主要结果</h4><p>{{ summary.main_result }}</p></div>
          <div class="field"><h4>创新点</h4><p>{{ summary.innovation }}</p></div>
          <div class="field"><h4>科研意义</h4><p>{{ summary.scientific_significance }}</p></div>
          <div class="field"><h4>科研资源</h4><p>{{ summary.resources or '未提供' }}</p></div>
        </div>
        {% endif %}
        <footer class="card-foot">
          <span>{{ analysis.item.published_at.strftime('%Y-%m-%d') }}</span>
          <span>{{ analysis.item.source }}</span>
          <a class="read-link" href="{{ analysis.item.url }}" target="_blank" rel="noopener noreferrer">阅读原文 →</a>
        </footer>
      </article>
    {%- endmacro %}

    <section class="view" data-view="daily">
      {% if daily %}
      <header class="report-head">
        <p class="eyebrow">Daily Report</p>
        <h2>今日精选</h2>
        <p class="meta">{{ daily.period_start.strftime('%Y-%m-%d') }} · {{ daily.items|length }} 项已完成处理的 AI4S 内容</p>
      </header>
      {% if daily.items %}
      <div class="cards">{% for item in daily.items %}{{ report_card(item) }}{% endfor %}</div>
      <p class="empty filter-empty" data-filter-empty>该领域在本期 Daily Report 中暂无内容。</p>
      {% else %}
      <p class="empty">本期 Daily Report 已生成，但没有符合条件的新内容。</p>
      {% endif %}
      {% else %}
      <header class="report-head"><p class="eyebrow">Daily Report</p><h2>今日精选</h2></header>
      <p class="empty">尚未生成 Daily Report。完成分析与摘要后再生成日报。</p>
      {% endif %}
    </section>

    <section class="view" data-view="weekly" hidden>
      {% if weekly %}
      <header class="report-head">
        <p class="eyebrow">AI4S Weekly</p>
        <h2>{{ weekly.period_start.strftime('%Y-%m-%d') }} → {{ weekly.period_end.strftime('%Y-%m-%d') }}</h2>
        <p class="meta">基于 {{ weekly.items|length }} 项代表工作的结构化趋势综合</p>
      </header>
      {% if weekly.items or weekly.overview %}
      <div class="weekly-layout">
        <section class="panel"><h3>本期概览</h3><p>{{ weekly.overview or '本期暂无足够信息形成概览。' }}</p></section>
        <section class="panel">
          <h3>领域趋势</h3>
          {% if weekly.category_trends %}
          <div class="trend-list">
            {% for category_id, label in categories if category_id != 'all' and category_id in weekly.category_trends %}
            <article class="trend"><h4>{{ label }}</h4><p>{{ weekly.category_trends[category_id] }}</p></article>
            {% endfor %}
          </div>
          {% else %}<p class="empty">本期暂无足够证据形成领域趋势。</p>{% endif %}
        </section>
        <section class="panel">
          <h3>持续关注</h3>
          {% if weekly.watchlist %}<ul class="watchlist">{% for topic in weekly.watchlist %}<li>{{ topic }}</li>{% endfor %}</ul>
          {% else %}<p class="empty">本期暂无新增关注方向。</p>{% endif %}
        </section>
        <section>
          <header class="report-head"><p class="eyebrow">Representative Works</p><h2>代表工作</h2></header>
          {% if weekly.items %}<div class="cards">{% for item in weekly.items %}{{ report_card(item, true) }}{% endfor %}</div>
          {% else %}<p class="empty">本期没有可展示的代表工作。</p>{% endif %}
          <p class="empty filter-empty" data-filter-empty>该领域在本期代表工作中暂无内容。</p>
        </section>
      </div>
      {% else %}
      <p class="empty">本期 Weekly Report 已生成，但没有符合条件的内容。</p>
      {% endif %}
      {% else %}
      <header class="report-head"><p class="eyebrow">AI4S Weekly</p><h2>Weekly Report</h2></header>
      <p class="empty">尚未生成 Weekly Report。周报将在 Wednesday 或 Sunday slot 生成。</p>
      {% endif %}
    </section>
  </main>

  <footer class="site-footer"><div class="shell">Static report snapshot · UTC reporting periods</div></footer>
  <script>
    let activeCategory = 'all';

    function activeViewName() {
      return location.hash === '#weekly' ? 'weekly' : 'daily';
    }

    function applyCategory() {
      document.querySelectorAll('[data-report-card]').forEach(card => {
        card.hidden = activeCategory !== 'all' && card.dataset.category !== activeCategory;
      });
      document.querySelectorAll('[data-filter-empty]').forEach(message => {
        const view = message.closest('[data-view]');
        const visible = Array.from(view.querySelectorAll('[data-report-card]')).some(card => !card.hidden);
        message.style.display = activeCategory !== 'all' && !visible ? 'block' : 'none';
      });
    }

    function setView() {
      const name = activeViewName();
      document.querySelectorAll('[data-view]').forEach(view => { view.hidden = view.dataset.view !== name; });
      document.querySelectorAll('[data-view-button]').forEach(button => {
        const active = button.dataset.viewButton === name;
        button.classList.toggle('active', active);
        button.setAttribute('aria-current', active ? 'page' : 'false');
      });
      applyCategory();
    }

    document.querySelectorAll('[data-category-button]').forEach(button => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.categoryButton;
        document.querySelectorAll('[data-category-button]').forEach(item => item.classList.toggle('active', item === button));
        applyCategory();
      });
    });
    document.querySelector('[data-category-button="all"]').classList.add('active');
    window.addEventListener('hashchange', setView);
    setView();
  </script>
</body>
</html>
