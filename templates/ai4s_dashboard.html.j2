<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="AI for Science 科研情报自动分析与趋势追踪">
  <title>AI4S Daily · Scientific Intelligence</title>
  {% include "_ai4s_styles.html.j2" %}
</head>
<body data-active-view="daily">
  <svg aria-hidden="true" width="0" height="0" style="position:absolute;overflow:hidden">
    <defs>
      <symbol id="icon-all" viewBox="0 0 64 64"><circle cx="32" cy="32" r="7" fill="currentColor"/><circle cx="14" cy="19" r="4" fill="currentColor"/><circle cx="50" cy="17" r="4" fill="currentColor"/><circle cx="15" cy="48" r="4" fill="currentColor"/><circle cx="51" cy="46" r="4" fill="currentColor"/><path d="M19 21l8 7m10-1l9-7M20 45l8-8m9 1l10 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></symbol>
      <symbol id="icon-biology" viewBox="0 0 64 64"><path d="M19 9c22 10 4 36 26 46M45 9C23 19 41 45 19 55M23 17h18M20 28h24M20 39h24M23 50h18" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/></symbol>
      <symbol id="icon-medicine" viewBox="0 0 64 64"><path d="M25 9h14v16h16v14H39v16H25V39H9V25h16z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><path d="M12 43h9l4-8 5 12 6-16 5 12h11" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></symbol>
      <symbol id="icon-chemistry" viewBox="0 0 64 64"><path d="M21 13l11-6 11 6v13l-11 6-11-6zM32 32v13m0 0l-11 6m11-6 11 6" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><circle cx="21" cy="51" r="5" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="43" cy="51" r="5" fill="none" stroke="currentColor" stroke-width="3"/></symbol>
      <symbol id="icon-materials" viewBox="0 0 64 64"><path d="M14 14h15v15H14zm21 0h15v15H35zM14 35h15v15H14zm21 0h15v15H35zM29 21h6M21 29v6m22-6v6m-14 8h6" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linejoin="round"/></symbol>
      <symbol id="icon-physics" viewBox="0 0 64 64"><circle cx="32" cy="32" r="5" fill="currentColor"/><ellipse cx="32" cy="32" rx="25" ry="10" fill="none" stroke="currentColor" stroke-width="2.5"/><ellipse cx="32" cy="32" rx="25" ry="10" transform="rotate(60 32 32)" fill="none" stroke="currentColor" stroke-width="2.5"/><ellipse cx="32" cy="32" rx="25" ry="10" transform="rotate(120 32 32)" fill="none" stroke="currentColor" stroke-width="2.5"/></symbol>
      <symbol id="icon-earth" viewBox="0 0 64 64"><circle cx="32" cy="32" r="24" fill="none" stroke="currentColor" stroke-width="3"/><path d="M8 32h48M32 8c9 8 13 16 13 24S41 48 32 56c-9-8-13-16-13-24S23 16 32 8zM13 20h38M13 44h38" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></symbol>
      <symbol id="icon-general" viewBox="0 0 64 64"><circle cx="32" cy="32" r="7" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="12" cy="17" r="5" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="52" cy="14" r="5" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="12" cy="49" r="5" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="52" cy="50" r="5" fill="none" stroke="currentColor" stroke-width="3"/><path d="M16 20l11 8m10-1l11-10M17 46l10-9m10 0l11 10" fill="none" stroke="currentColor" stroke-width="3"/></symbol>
    </defs>
  </svg>

  {% macro category_icon(category_id) -%}<svg aria-hidden="true" viewBox="0 0 64 64"><use href="#icon-{{ category_id }}"></use></svg>{%- endmacro %}

  <header class="site-header">
    <div class="shell header-inner">
      <a class="brand" href="#top" aria-label="AI4S Daily 首页"><span class="brand-mark">{{ category_icon('all') }}</span><span class="brand-copy"><strong>AI4S Daily</strong><span>Scientific Intelligence</span></span></a>
      <nav class="primary-nav" aria-label="主要导航">
        <a href="#daily" data-view-button="daily">Daily</a><a href="#weekly" data-view-button="weekly">Weekly</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="kicker">AI for Science · Research Intelligence</p>
          <h1 id="hero-title">AI4S Daily<span>AI for Science 科研情报自动分析与趋势追踪</span></h1>
          <p class="hero-description">自动聚合论文、模型、数据集、科研工具与研究动态，并提取科学问题、AI 方法、关键结果与研究价值。</p>
          <div class="hero-metrics" aria-label="多源科研情报概览"><div class="hero-metric"><strong>{{ source_coverage.active_count }}</strong><span>Active Sources</span></div><div class="hero-metric"><strong>{{ source_coverage.family_count }}</strong><span>Source Types</span></div><div class="hero-metric"><strong>{{ daily_overview.source_count }}</strong><span>Sources in Today's Daily</span></div><div class="hero-metric"><strong>{{ daily_overview.covered_categories }}</strong><span>Scientific Domains</span></div></div>
        </div>
        <div class="hero-visual" aria-label="AI4S 科学领域关联图">
          <svg class="intelligence-map" viewBox="0 0 400 380" role="img" aria-labelledby="map-title map-description"><title id="map-title">Scientific Intelligence Map</title><desc id="map-description">AI 连接生物、医学、化学、材料、物理与地球科学。</desc><circle class="map-ring" cx="200" cy="180" r="115"/><circle class="map-ring" cx="200" cy="180" r="77"/><path class="map-line" d="M200 180L96 92M200 180L198 51M200 180L307 91M200 180L327 226M200 180L220 313M200 180L79 250"/><circle class="map-node" cx="96" cy="92" r="31"/><circle class="map-node" cx="198" cy="51" r="30"/><circle class="map-node" cx="307" cy="91" r="31"/><circle class="map-node" cx="327" cy="226" r="31"/><circle class="map-node" cx="220" cy="313" r="31"/><circle class="map-node" cx="79" cy="250" r="31"/><circle class="map-core" cx="200" cy="180" r="41"/><text class="map-label" x="96" y="96">Biology</text><text class="map-label" x="198" y="55">Medicine</text><text class="map-label" x="307" y="95">Chemistry</text><text class="map-label" x="327" y="230">Materials</text><text class="map-label" x="220" y="317">Physics</text><text class="map-label" x="79" y="254">Earth</text><text class="map-label map-core-label" x="200" y="185">AI</text></svg>
          <p class="map-caption">Scientific Intelligence Map</p>
        </div>
      </div>
    </section>

    {% if source_coverage.groups %}<section class="source-coverage shell" aria-labelledby="source-coverage-title">
      <header class="source-coverage-head"><div><p class="eyebrow">Source Coverage</p><h2 id="source-coverage-title">多源科研信号</h2></div><strong>{{ source_coverage.active_count }} active sources</strong></header>
      <div class="source-coverage-grid">{% for group in source_coverage.groups %}<div class="source-group" data-source-group="{{ group.id }}"><div class="source-group-title"><span>{{ group.label }}</span><strong>{{ group.count }} sources</strong></div><p>{{ group.providers|join(' · ') }}</p></div>{% endfor %}</div>
    </section>{% endif %}

    <section class="overview shell" id="categories" aria-labelledby="overview-title">
      <div class="section-heading overview-heading"><div><p class="eyebrow">Signal Overview</p><h2 id="overview-title">科研情报概览</h2></div><p><span data-dashboard-mode>Daily</span> 报告中的领域覆盖、内容结构与当前关注重心。</p></div>
      <div class="dashboard-grid">
        <section class="dashboard-panel" aria-labelledby="domain-distribution-title"><header class="dashboard-panel-head"><h3 id="domain-distribution-title">领域分布</h3><p class="panel-intro">按本期入选内容统计</p></header><div class="dashboard-panel-content category-bars">
          {% for category_id, label in categories if category_id != 'all' %}<div class="bar-row" data-category="{{ category_id }}" data-dashboard-category data-label="{{ label }}" data-count-daily="{{ daily_category_counts[category_id] }}" data-count-weekly="{{ weekly_category_counts[category_id] }}"><span class="bar-label">{{ category_icon(category_id) }}<span>{{ label }}</span></span><span class="bar-track" aria-hidden="true"><span class="bar-fill" data-bar-fill></span></span><span class="bar-count" data-bar-count>{{ daily_category_counts[category_id] }}</span></div>{% endfor %}
          <div class="overview-callout"><span>最高关注领域</span><strong data-top-category>{% if daily_overview.top_category %}{{ category_labels[daily_overview.top_category] }} · {{ daily_category_counts[daily_overview.top_category] }}{% else %}暂无数据{% endif %}</strong></div>
        </div></section>
        <section class="dashboard-panel" aria-labelledby="source-distribution-title"><header class="dashboard-panel-head"><h3 id="source-distribution-title">今日来源构成</h3><p class="panel-intro">Source Distribution · 当前报告真实入选来源</p></header><div class="dashboard-panel-content source-distribution">
          <div class="source-bars">{% for source in source_distribution %}<div class="source-bar-row" data-dashboard-source data-label="{{ source.name }}" data-count-daily="{{ source.daily_count }}" data-count-weekly="{{ source.weekly_count }}"><span>{{ source.name }}</span><span class="bar-track" aria-hidden="true"><span class="bar-fill" data-source-bar-fill></span></span><strong data-source-bar-count>{{ source.daily_count }}</strong></div>{% endfor %}</div>
          <p class="source-summary" data-source-summary data-text-daily="今日 {{ daily_overview.total }} 篇精选来自 {{ daily_overview.source_count }} 个不同信息源" data-text-weekly="本周 {{ weekly_overview.total }} 项代表工作来自 {{ weekly_overview.source_count }} 个不同信息源">今日 {{ daily_overview.total }} 篇精选来自 {{ daily_overview.source_count }} 个不同信息源</p>
          <div class="content-type-compact"><span>内容类型</span><div class="distribution-track" aria-hidden="true">{% for content_type, label in content_type_labels.items() %}<span class="distribution-segment" data-type-segment data-count-daily="{{ daily_overview.content_type_counts[content_type] }}" data-count-weekly="{{ weekly_overview.content_type_counts[content_type] }}"></span>{% endfor %}</div><div class="distribution-legend">{% for content_type, label in content_type_labels.items() %}<div class="legend-item" data-type-legend data-count-daily="{{ daily_overview.content_type_counts[content_type] }}" data-count-weekly="{{ weekly_overview.content_type_counts[content_type] }}"><span class="legend-name"><span class="legend-dot"></span>{{ label }}</span><strong data-type-count>{{ daily_overview.content_type_counts[content_type] }}</strong></div>{% endfor %}</div></div>
        </div></section>
      </div>
      <div class="filter-stack"><div class="filter-row"><span class="filter-label">Category</span><nav class="category-nav" aria-label="领域筛选">{% for category_id, label in categories %}<button type="button" class="{{ 'is-zero' if daily_category_counts[category_id] == 0 else '' }}" data-category="{{ category_id }}" data-category-button="{{ category_id }}" data-count-daily="{{ daily_category_counts[category_id] }}" data-count-weekly="{{ weekly_category_counts[category_id] }}">{{ category_icon(category_id) }}<span class="category-label">{{ label }}</span><span class="count-badge" data-category-count>{{ format_category_count(daily_category_counts[category_id]) }}</span></button>{% endfor %}</nav></div>
      <div class="filter-row"><span class="filter-label">Source</span><nav class="source-nav" aria-label="来源筛选">{% for source_filter in source_filters %}<button type="button" class="{{ 'is-zero' if source_filter.daily_count == 0 else '' }}" data-source-filter-kind="{{ source_filter.kind }}" data-source-filter-value="{{ source_filter.value }}" data-count-daily="{{ source_filter.daily_count }}" data-count-weekly="{{ source_filter.weekly_count }}"><span>{{ source_filter.label }}</span><span class="count-badge" data-source-filter-count>{{ format_category_count(source_filter.daily_count) }}</span></button>{% endfor %}</nav></div></div>
    </section>

    {% macro report_card(card) -%}
      {% set report_item = card.report_item %}{% set analysis = report_item.analysis %}
      <article class="intel-card" data-report-card data-category="{{ report_item.category }}" data-source="{{ analysis.item.source }}" data-source-family="{{ card.source.family }}" data-source-name="{{ card.source.key }}"><div class="card-grid{% if card.image_url %} has-thumbnail{% endif %}"><div class="card-copy">
        <h3><a href="{{ analysis.item.url }}" target="_blank" rel="noopener noreferrer">{{ analysis.item.title }}</a></h3>
        <div class="badges"><span class="badge">{{ category_icon(report_item.category) }}{{ category_labels[report_item.category] }}</span><span class="badge type">{{ content_type_labels[analysis.analyzer.content_type] }}</span><span class="badge source">{{ card.source.display_name }}</span><span class="badge source-type">{{ card.source.type_label }}</span><span class="article-date">{{ card.date_label }}</span><span class="score {{ 'high' if analysis.analyzer.score >= 8 else 'mid' }}">{{ analysis.analyzer.score }}/10</span></div>
        {% if analysis.analyzer.tags %}<div class="tags">{% for tag in analysis.analyzer.tags %}<span class="tag">{{ tag }}</span>{% endfor %}</div>{% endif %}
        {% if card.low_information %}<div class="low-information"><h4>信息有限</h4><p>当前来源仅提供简短介绍，暂无足够信息生成完整科研解读。</p></div>{% else %}
        <div class="summary-stack">{% if card.overview %}<section class="work-overview"><h4 class="sr-only">工作概述</h4><div class="overview-lines">{% for section in card.overview %}<p class="fact-{{ section.field }}"><strong>{{ section.label }}</strong><span>{{ section.text }}</span></p>{% endfor %}</div></section>{% endif %}{% if card.assessment %}<section class="assessment"><h4>分析研判</h4><p>{{ card.assessment }}</p></section>{% endif %}</div>{% endif %}
        {% if card.resources %}<div class="resources"><h4>科研资源</h4><p>{{ card.resources }}</p></div>{% endif %}<footer class="card-foot"><a class="read-link" href="{{ analysis.item.url }}" target="_blank" rel="noopener noreferrer">阅读原文 →</a></footer>
      </div>{% if card.image_url %}<figure class="source-thumbnail" data-source-thumbnail><img src="{{ card.image_url }}" alt="" width="112" height="96" loading="lazy" decoding="async" referrerpolicy="no-referrer" data-source-image></figure>{% endif %}</div></article>
    {%- endmacro %}

    {% macro evidence_row(card) -%}
      {% set report_item = card.report_item %}{% set analysis = report_item.analysis %}
      <article class="evidence-row" data-report-card data-category="{{ report_item.category }}" data-source="{{ analysis.item.source }}" data-source-family="{{ card.source.family }}" data-source-name="{{ card.source.key }}">
        <span class="badge">{{ category_icon(report_item.category) }}{{ category_labels[report_item.category] }}</span>
        <div class="evidence-copy"><h3><a href="{{ analysis.item.url }}" target="_blank" rel="noopener noreferrer">{{ analysis.item.title }}</a></h3><p>{{ card.evidence or '信息有限，建议查看原文了解完整方法与结果。' }}</p></div>
        <span class="evidence-source">{{ card.source.display_name }}<small>{{ content_type_labels[analysis.analyzer.content_type] }}</small></span>
      </article>
    {%- endmacro %}

    <div class="shell">
      <section class="view" id="daily" data-view="daily">{% if daily %}<header class="report-head"><div><p class="eyebrow">Today's Highlights</p><h2>今日科研精选</h2></div><p class="meta">{{ daily.items|length }} 篇科研精选 · 来自 {{ daily_overview.source_count }} 个信息源 · 覆盖 {{ daily_overview.covered_categories }} 个领域</p></header>{% if daily.items %}<div class="cards">{% for card in daily_cards %}{{ report_card(card) }}{% endfor %}</div><p class="empty filter-empty" data-filter-empty>当前领域与来源组合暂无内容。</p>{% else %}<p class="empty">本期 Daily Report 已生成，但没有符合条件的新内容。</p>{% endif %}{% else %}<header class="report-head"><div><p class="eyebrow">Today's Highlights</p><h2>今日科研精选</h2></div></header><p class="empty">尚未生成 Daily Report。完成分析与摘要后再生成日报。</p>{% endif %}</section>

      <section class="view" id="weekly" data-view="weekly" hidden>{% if weekly %}<header class="report-head"><div><p class="eyebrow">Weekly Intelligence Brief</p><h2>全局研究趋势</h2></div><p class="meta">{{ weekly.period_start.strftime('%Y-%m-%d') }} → {{ weekly.period_end.strftime('%Y-%m-%d') }} · {{ weekly.items|length }} 项代表工作来自 {{ weekly_overview.source_count }} 个信息源</p></header>{% if weekly.items or weekly.overview %}<div class="weekly-layout">
        <section class="weekly-overview"><div class="weekly-stat"><strong>{{ weekly.items|length }}</strong><span>Representative works</span></div><div><h3>本周判断</h3><p>{{ weekly.overview or '本期暂无足够信息形成概览。' }}</p></div></section>
        <section class="weekly-section"><div class="weekly-section-head"><h3>领域走向</h3><span>跨工作共性与证据边界</span></div>{% if weekly.category_trends %}<div class="trend-list">{% for category_id, label in categories if category_id != 'all' and category_id in weekly.category_trends %}<article class="trend" data-category="{{ category_id }}"><div class="trend-head">{{ category_icon(category_id) }}<h4>{{ label }}</h4></div><p>{{ weekly.category_trends[category_id] }}</p></article>{% endfor %}</div>{% else %}<p class="empty">本期暂无足够证据形成领域趋势。</p>{% endif %}</section>
        <section class="watchlist-panel"><div><p class="eyebrow">Research Watchlist</p><h3>下一阶段观察</h3></div>{% if weekly.watchlist %}<ul class="watchlist">{% for topic in weekly.watchlist %}<li>{{ topic }}</li>{% endfor %}</ul>{% else %}<p>本期暂无新增关注方向。</p>{% endif %}</section>
        <section><header class="report-head"><div><p class="eyebrow">Representative Works</p><h2>代表性工作 / Evidence</h2></div><p class="meta">为本周判断提供事实依据</p></header>{% if weekly.items %}<div data-weekly-filters></div><div class="evidence-list">{% for card in weekly_cards %}{{ evidence_row(card) }}{% endfor %}</div>{% else %}<p class="empty">本期没有可展示的代表工作。</p>{% endif %}<p class="empty filter-empty" data-filter-empty>该领域在本期代表工作中暂无内容。</p></section>
      </div>{% else %}<p class="empty">本期 Weekly Report 已生成，但没有符合条件的内容。</p>{% endif %}{% else %}<header class="report-head"><div><p class="eyebrow">Weekly Intelligence Brief</p><h2>全局研究趋势</h2></div></header><p class="empty">尚未生成 Weekly Report。周报将在 Wednesday 或 Sunday slot 生成。</p>{% endif %}</section>

      <section class="system-section" id="about" aria-labelledby="pipeline-title"><div class="section-heading"><div><p class="eyebrow">Automated Research Pipeline</p><h2 id="pipeline-title">How AI4S Daily Works</h2></div><p>从多源科研信号到可阅读的 Daily / Weekly 情报，流程保持可追踪、可重复发布。</p></div>
        <div class="pipeline" aria-label="AI4S Daily 自动化流程">{% for title, description in [('Sources', '论文与科研动态'), ('Fetcher', '统一抓取与去重'), ('AI4S Analyzer', '分类与价值评分'), ('High-value Filter', '筛选高质量信号'), ('Summarizer', '结构化科研解读'), ('Daily / Weekly', '日报与趋势综合'), ('GitHub Pages', '静态自动发布')] %}<div class="pipeline-step"><span class="pipeline-index">0{{ loop.index }}</span><strong>{{ title }}</strong><span>{{ description }}</span></div>{% endfor %}</div>
        <div class="system-status" aria-label="系统状态"><div class="status-card online"><span>Pipeline</span><strong>Automated</strong></div><div class="status-card"><span>Last Update</span><strong>{{ generated_at }}</strong></div><div class="status-card"><span>Report Items</span><strong>{{ daily_overview.total }} Daily · {{ weekly_overview.total }} Weekly</strong></div><div class="status-card"><span>Sources</span><strong>{{ source_count }} active in reports</strong></div></div>
      </section>
    </div>
  </main>

  <footer class="site-footer"><div class="shell footer-inner"><span>AI-assisted scientific intelligence · Static deployment</span><nav class="footer-links" aria-label="辅助导航"><a href="#categories">Categories</a><a href="#about">How it works</a></nav><span>UTC reporting periods · Automated by GitHub Actions</span></div></footer>

  <script>
    let activeCategory = 'all';
    let activeSourceKind = 'all';
    let activeSourceValue = 'all';
    function activeViewName() { if (location.hash === '#weekly') return 'weekly'; if (location.hash === '#daily') return 'daily'; return document.body.dataset.activeView || 'daily'; }
    function updateCategoryCounts(viewName) { document.querySelectorAll('[data-category-button]').forEach(button => { const count = Number(button.getAttribute(`data-count-${viewName}`)); const countLabel = count >= 100 ? '99+' : String(count); const categoryLabel = button.querySelector('.category-label').textContent; button.querySelector('[data-category-count]').textContent = countLabel; button.classList.toggle('is-zero', count === 0); button.setAttribute('aria-label', `${categoryLabel} ${countLabel}`); }); }
    function updateSourceFilterCounts(viewName) { document.querySelectorAll('[data-source-filter-kind]').forEach(button => { const count = Number(button.getAttribute(`data-count-${viewName}`)); const countLabel = count >= 100 ? '99+' : String(count); button.querySelector('[data-source-filter-count]').textContent = countLabel; button.classList.toggle('is-zero', count === 0); }); }
    function updateDashboard(viewName) {
      const rows = Array.from(document.querySelectorAll('[data-dashboard-category]')); const counts = rows.map(row => Number(row.getAttribute(`data-count-${viewName}`))); const maxCount = Math.max(0, ...counts);
      rows.forEach((row, index) => { const count = counts[index]; row.querySelector('[data-bar-count]').textContent = String(count); row.querySelector('[data-bar-fill]').style.width = `${maxCount ? (count / maxCount) * 100 : 0}%`; });
      const sourceRows = Array.from(document.querySelectorAll('[data-dashboard-source]')); const sourceCounts = sourceRows.map(row => Number(row.getAttribute(`data-count-${viewName}`))); const maxSourceCount = Math.max(0, ...sourceCounts);
      sourceRows.forEach((row, index) => { const count = sourceCounts[index]; row.hidden = count === 0; row.querySelector('[data-source-bar-count]').textContent = String(count); row.querySelector('[data-source-bar-fill]').style.width = `${maxSourceCount ? (count / maxSourceCount) * 100 : 0}%`; });
      const sourceSummary = document.querySelector('[data-source-summary]'); if (sourceSummary) sourceSummary.textContent = sourceSummary.getAttribute(`data-text-${viewName}`);
      document.querySelectorAll('[data-type-segment]').forEach(segment => { const count = Number(segment.getAttribute(`data-count-${viewName}`)); segment.style.flexGrow = String(count); segment.hidden = count === 0; });
      document.querySelectorAll('[data-type-legend]').forEach(item => { item.querySelector('[data-type-count]').textContent = item.getAttribute(`data-count-${viewName}`); });
      const topIndex = counts.indexOf(Math.max(...counts)); document.querySelector('[data-top-category]').textContent = maxCount ? `${rows[topIndex].dataset.label} · ${maxCount}` : '暂无数据'; document.querySelector('[data-dashboard-mode]').textContent = viewName === 'weekly' ? 'Weekly' : 'Daily';
    }
    function applyFilters() { document.querySelectorAll('[data-report-card]').forEach(card => { const categoryMatches = activeCategory === 'all' || card.dataset.category === activeCategory; const sourceMatches = activeSourceKind === 'all' || (activeSourceKind === 'family' ? card.dataset.sourceFamily === activeSourceValue : card.dataset.sourceName === activeSourceValue); card.hidden = !(categoryMatches && sourceMatches); }); document.querySelectorAll('[data-filter-empty]').forEach(message => { const view = message.closest('[data-view]'); const visible = Array.from(view.querySelectorAll('[data-report-card]')).some(card => !card.hidden); message.style.display = (activeCategory !== 'all' || activeSourceKind !== 'all') && !visible ? 'block' : 'none'; }); }
    function initializeScienceImages() {
      document.querySelectorAll('[data-source-image]').forEach(image => {
        const removeThumbnail = () => {
          image.closest('.card-grid').classList.remove('has-thumbnail');
          image.closest('[data-source-thumbnail]').remove();
        };
        image.addEventListener('error', removeThumbnail, { once: true });
        if (image.complete && !image.naturalWidth) removeThumbnail();
      });
    }
    function setView() { const name = activeViewName(); document.body.dataset.activeView = name; const filterHost = document.querySelector(name === 'weekly' ? '[data-weekly-filters]' : '#categories'); if (filterHost) filterHost.append(document.querySelector('.filter-stack')); document.querySelectorAll('[data-view]').forEach(view => { view.hidden = view.dataset.view !== name; }); document.querySelectorAll('[data-view-button]').forEach(button => { const active = button.dataset.viewButton === name; button.classList.toggle('active', active); button.setAttribute('aria-current', active ? 'page' : 'false'); }); updateCategoryCounts(name); updateSourceFilterCounts(name); updateDashboard(name); applyFilters(); }
    document.querySelectorAll('[data-category-button]').forEach(button => { button.addEventListener('click', () => { activeCategory = button.dataset.categoryButton; document.querySelectorAll('[data-category-button]').forEach(item => item.classList.toggle('active', item === button)); applyFilters(); document.querySelector(`[data-view="${activeViewName()}"]`).scrollIntoView({ behavior: 'smooth', block: 'start' }); }); });
    document.querySelectorAll('[data-source-filter-kind]').forEach(button => { button.addEventListener('click', () => { activeSourceKind = button.dataset.sourceFilterKind; activeSourceValue = button.dataset.sourceFilterValue; document.querySelectorAll('[data-source-filter-kind]').forEach(item => item.classList.toggle('active', item === button)); applyFilters(); document.querySelector(`[data-view="${activeViewName()}"]`).scrollIntoView({ behavior: 'smooth', block: 'start' }); }); });
    document.querySelector('[data-category-button="all"]').classList.add('active'); document.querySelector('[data-source-filter-kind="all"]').classList.add('active'); window.addEventListener('hashchange', setView); initializeScienceImages(); setView();
  </script>
</body>
</html>
